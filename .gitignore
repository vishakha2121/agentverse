"@ | Out-File -Encoding utf8 .gitignore
✅ Option 3: Git Bash se
bash
cat > .gitignore << 'EOF'
__pycache__/
*.py[cod]
venv/
.venv/
node_modules/
dist/
build/
.vite/
.env
.env.local
*.log
*.db
*.sqlite3
.pytest_cache/
.vscode/
.idea/
.DS_Store
