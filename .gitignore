*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
.aws/
.gcloud/
.azure/

# ==========================================================
#  📦 CACHES / TEMP / MISC
# ==========================================================
.cache/
.temp/
.tmp/
temp/
tmp/
